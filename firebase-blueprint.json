{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile linking Firebase Auth UID to active tenant and roles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "tenantId": { "type": "string", "description": "Reference to the owner tenant" },
        "role": { "type": "string", "enum": ["owner", "admin", "kasir", "pegawai"], "description": "Access control role" },
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Contact phone" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "activeOutletId": { "type": "string", "description": "Outlet where the user is currently working" },
        "isActive": { "type": "boolean", "description": "Active state of employment" },
        "isDeleted": { "type": "boolean", "description": "Logical deletion marker" },
        "createdAt": { "type": "string", "description": "Account registration timestamp object" },
        "updatedAt": { "type": "string", "description": "Timestamp of modification" },
        "lastLoginAt": { "type": "string", "description": "Timestamp of last session start" }
      },
      "required": ["userId", "tenantId", "role", "name", "email", "activeOutletId", "isActive", "isDeleted", "createdAt"]
    },
    "tenant": {
      "title": "Tenant",
      "description": "SaaS tenant representing the entire laundry business entity.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string", "description": "Unique tenant ID (often matches Owner ID)" },
        "businessName": { "type": "string", "description": "Name of the Laundry enterprise" },
        "businessType": { "type": "string", "description": "Classification of laundry workspace" },
        "ownerId": { "type": "string", "description": "UID of the owner user" },
        "plan": { "type": "string", "enum": ["free", "basic", "premium"], "description": "Subscription tier" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "suspended", "expired"], "description": "Status of billing pipeline" },
        "maxOutlets": { "type": "number", "description": "Max permitted branches" },
        "maxEmployees": { "type": "number", "description": "Max staff limit" },
        "timezone": { "type": "string", "description": "Branch zone config" },
        "currency": { "type": "string", "description": "Localization money format code" },
        "isActive": { "type": "boolean", "description": "Workspace active validation" },
        "isDeleted": { "type": "boolean", "description": "Deletion flag" },
        "createdAt": { "type": "string", "description": "Organization setup timestamp" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" }
      },
      "required": ["tenantId", "businessName", "ownerId", "plan", "subscriptionStatus", "isActive", "isDeleted", "createdAt"]
    },
    "outlet": {
      "title": "Outlet",
      "description": "Individual laundry outlet under a specific business tenant.",
      "type": "object",
      "properties": {
        "outletId": { "type": "string", "description": "Unique multi-outlet reference" },
        "tenantId": { "type": "string", "description": "Associated business reference" },
        "code": { "type": "string", "description": "Compact outlet ID identifier code" },
        "name": { "type": "string", "description": "Outlet name" },
        "address": { "type": "string", "description": "Physical location address" },
        "phone": { "type": "string", "description": "Branch contact phone" },
        "isMainOutlet": { "type": "boolean", "description": "Flag identifying headquarters" },
        "printerName": { "type": "string", "description": "Thermal Bluetooth printer identifier" },
        "receiptFooter": { "type": "string", "description": "Receipt trailer message note" },
        "isActive": { "type": "boolean", "description": "Operational flag status" },
        "isDeleted": { "type": "boolean", "description": "Soft deletion check" },
        "createdAt": { "type": "string", "description": "Outlet registration date" },
        "updatedAt": { "type": "string", "description": "Date update occurred" }
      },
      "required": ["outletId", "tenantId", "name", "address", "phone", "isActive", "isDeleted", "createdAt"]
    },
    "service": {
      "title": "Service",
      "description": "Laundry services offered by the tenant (kiloan, satuan, sepatu, dry-clean, etc.).",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string", "description": "Unique service ID" },
        "tenantId": { "type": "string", "description": "Business reference ID owner" },
        "name": { "type": "string", "description": "Service name" },
        "category": { "type": "string", "description": "Grouping identifier" },
        "type": { "type": "string", "enum": ["kiloan", "satuan", "sepatu", "karpet", "other"], "description": "Format metrics" },
        "unit": { "type": "string", "enum": ["kg", "pcs", "pair", "m2"], "description": "Pricing metric unit" },
        "price": { "type": "number", "description": "Operational tariff cost" },
        "estimatedHours": { "type": "number", "description": "SLA standard metrics" },
        "queueCategory": { "type": "string", "description": "Conveyor queue sorting bucket" },
        "isExpress": { "type": "boolean", "description": "Express delivery toggle" },
        "isActive": { "type": "boolean", "description": "Availability toggler" },
        "isDeleted": { "type": "boolean", "description": "Logical removal indicator" },
        "createdAt": { "type": "string", "description": "Setup timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated" }
      },
      "required": ["serviceId", "tenantId", "name", "type", "unit", "price", "isActive", "isDeleted", "createdAt"]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer profiles registered within the tenant space.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "description": "Unique customer reference" },
        "tenantId": { "type": "string", "description": "Isolated workspace owner reference" },
        "name": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Mobile phone" },
        "address": { "type": "string", "description": "Home delivery address" },
        "notes": { "type": "string", "description": "Optional details" },
        "totalOrders": { "type": "number", "description": "Accumulated orders count" },
        "totalSpent": { "type": "number", "description": "Total billing currency accumulated" },
        "memberLevel": { "type": "string", "description": "Classification status tiered" },
        "points": { "type": "number", "description": "Loyalty points wallet" },
        "lastOrderAt": { "type": "string", "description": "Late transaction date" },
        "isDeleted": { "type": "boolean", "description": "Deletion logic" },
        "createdAt": { "type": "string", "description": "Registration index setup" },
        "updatedAt": { "type": "string", "description": "Edit snapshot" }
      },
      "required": ["customerId", "tenantId", "name", "phone", "isDeleted", "createdAt"]
    },
    "employee": {
      "title": "Employee",
      "description": "Internal working representative credentials.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "description": "Primary identity" },
        "userId": { "type": "string", "description": "Referenced credential maps profile" },
        "tenantId": { "type": "string", "description": "Linked business owner" },
        "outletId": { "type": "string", "description": "Location assignment target" },
        "role": { "type": "string", "description": "Employment level clearance" },
        "fullName": { "type": "string", "description": "Full legal name" },
        "phone": { "type": "string", "description": "Contact info" },
        "salaryType": { "type": "string", "description": "Finance structure mapping" },
        "joinDate": { "type": "string", "description": "Day of joining business" },
        "isActive": { "type": "boolean", "description": "Active operational indicator" },
        "isDeleted": { "type": "boolean", "description": "Logical delete state" },
        "createdAt": { "type": "string", "description": "Setup log" },
        "updatedAt": { "type": "string", "description": "Metadata edit timestamp" }
      },
      "required": ["employeeId", "userId", "tenantId", "outletId", "role", "fullName", "phone", "isActive", "isDeleted", "createdAt"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Operational master ledger of invoice elements omitting direct heavy arrays.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "description": "Unique order ID" },
        "tenantId": { "type": "string", "description": "Tenant owner relation index code" },
        "outletId": { "type": "string", "description": "Active checkout outlet branch" },
        "invoiceNumber": { "type": "string", "description": "Branded formal customer invoice number" },
        "queueNumber": { "type": "string", "description": "Daily index order index" },
        "customerId": { "type": "string", "description": "Referenced CRM customer profile record" },
        "customerName": { "type": "string", "description": "Cached database field" },
        "customerPhone": { "type": "string", "description": "Cached validation field" },
        "cashierId": { "type": "string", "description": "Checkout processing logging user ID" },
        "cashierName": { "type": "string", "description": "Name profile check out tracker logger" },
        "totalItems": { "type": "number", "description": "Item items sum index" },
        "totalQty": { "type": "number", "description": "Volume metrics total quantity sum" },
        "subtotal": { "type": "number", "description": "Sum listing items overall rates" },
        "discount": { "type": "number", "description": "Operational deduction amount" },
        "tax": { "type": "number", "description": "Percent or fixed tax surcharge fees" },
        "grandTotal": { "type": "number", "description": "Billing invoice amount due" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "partial", "paid", "refunded"], "description": "Invoiced stage status" },
        "orderStatus": { "type": "string", "enum": ["created", "queued", "washing", "drying", "ironing", "packing", "ready", "completed", "picked_up", "cancelled"], "description": "Operational pipeline index tracking laundry milestones" },
        "paymentMethod": { "type": "string", "description": "Instrument mapping option" },
        "receivedAt": { "type": "string", "description": "Initial order placement date" },
        "estimatedDoneAt": { "type": "string", "description": "Agreed SLA target timestamp" },
        "completedAt": { "type": "string", "description": "Active setup complete log date" },
        "pickedUpAt": { "type": "string", "description": "Hand back CRM transaction timestamp" },
        "notes": { "type": "string", "description": "Checkout user notes" },
        "source": { "type": "string", "description": "POS platform descriptor" },
        "isDeleted": { "type": "boolean", "description": "Logical deletion identifier" },
        "createdAt": { "type": "string", "description": "System setup datetime log" },
        "updatedAt": { "type": "string", "description": "Last edit timestamp" }
      },
      "required": ["transactionId", "tenantId", "outletId", "customerId", "customerName", "paymentStatus", "orderStatus", "paymentMethod", "receivedAt", "isDeleted", "createdAt"]
    },
    "transactionItem": {
      "title": "Transaction Item",
      "description": "Details of individual laundry services within an order subcollection.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "description": "Primary unique key reference" },
        "serviceId": { "type": "string", "description": "Standard catalog item relation mapping key" },
        "serviceName": { "type": "string", "description": "Name profile cached validation" },
        "qty": { "type": "number", "description": "Quantity quantity parsed" },
        "unitPrice": { "type": "number", "description": "Cost per unit metrics" },
        "subtotal": { "type": "number", "description": "Extended calculated fee index sum" },
        "notes": { "type": "string", "description": "Processor guidance guidelines" },
        "itemStatus": { "type": "string", "description": "Item workflow stage tracking metrics" },
        "createdAt": { "type": "string", "description": "System datetime stamp of setup" }
      },
      "required": ["itemId", "serviceId", "serviceName", "qty", "unitPrice", "subtotal", "createdAt"]
    },
    "expense": {
      "title": "Expense",
      "description": "Operational overhead cost database tracked per branch.",
      "type": "object",
      "properties": {
        "expenseId": { "type": "string", "description": "Unique expense identifier log entry ID" },
        "tenantId": { "type": "string", "description": "Reference to parent tenant space" },
        "outletId": { "type": "string", "description": "Branch assignment key location mapper" },
        "category": { "type": "string", "description": "Type of expense class" },
        "title": { "type": "string", "description": "Compact title" },
        "notes": { "type": "string", "description": "Extended detail note" },
        "amount": { "type": "number", "description": "Currency value" },
        "expenseDate": { "type": "string", "description": "Date expenditure occurred" },
        "createdBy": { "type": "string", "description": "Operator user ID" },
        "createdByName": { "type": "string", "description": "Operator user name" },
        "createdAt": { "type": "string", "description": "Log log timestamp" },
        "updatedAt": { "type": "string", "description": "Modification timestamp" },
        "isDeleted": { "type": "boolean", "description": "Soft deletion check" }
      },
      "required": ["expenseId", "tenantId", "outletId", "category", "title", "amount", "expenseDate", "createdBy", "createdAt"]
    },
    "shiftClosing": {
      "title": "ShiftClosing",
      "description": "Track shift state and cashier cash ledger totals dynamically.",
      "type": "object",
      "properties": {
        "shiftId": { "type": "string", "description": "Unique shift record identifier" },
        "tenantId": { "type": "string", "description": "Parent organizational tenant reference ID" },
        "outletId": { "type": "string", "description": "SaaS branch assignment ID location" },
        "cashierId": { "type": "string", "description": "The cashier UID operator who ran the shift" },
        "cashierName": { "type": "string", "description": "Name profile label of working operator" },
        "openedAt": { "type": "string", "description": "Clock start timestamp of shift" },
        "closedAt": { "type": "string", "description": "Clock end timestamp of shift" },
        "openingCash": { "type": "number", "description": "Starting base cash float amount" },
        "expectedCash": { "type": "number", "description": "Sum of base cash plus logged transactions cash amount" },
        "actualCash": { "type": "number", "description": "Cash counting input total recorded" },
        "cashDifference": { "type": "number", "description": "Surplus or deficit comparison" },
        "totalTransactions": { "type": "number", "description": "Total quantity checkout transactions during shift" },
        "totalRevenue": { "type": "number", "description": "Total financial turnover during active shift" },
        "notes": { "type": "string", "description": "End-of-shift notes" },
        "status": { "type": "string", "enum": ["open", "closed"], "description": "Current status" },
        "createdAt": { "type": "string", "description": "Timestamp shift document setup" },
        "updatedAt": { "type": "string", "description": "Timestamp shift closure or edit" }
      },
      "required": ["shiftId", "tenantId", "outletId", "cashierId", "cashierName", "openedAt", "openingCash", "expectedCash", "status", "createdAt"]
    },
    "dailyReport": {
      "title": "Daily Report",
      "description": "Pre-aggregated statistics summaries mapping metrics per date.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "description": "Date string composite ID" },
        "date": { "type": "string", "description": "Date format string YYYY-MM-DD" },
        "outletId": { "type": "string", "description": "Branch identifier" },
        "totalRevenue": { "type": "number", "description": "Total closed earnings" },
        "totalExpense": { "type": "number", "description": "Overhead total sum" },
        "netProfit": { "type": "number", "description": "Profits calculation" },
        "totalOrders": { "type": "number", "description": "Quantity processed orders" },
        "unpaidOrders": { "type": "number", "description": "Volume awaiting payment" },
        "paidOrders": { "type": "number", "description": "Volume paid and closed" },
        "createdAt": { "type": "string", "description": "Created date log" },
        "updatedAt": { "type": "string", "description": "Update aggregations log" }
      },
      "required": ["reportId", "date", "outletId", "totalRevenue", "totalExpense", "netProfit", "totalOrders", "unpaidOrders", "paidOrders", "createdAt", "updatedAt"]
    },
    "activityLog": {
      "title": "Activity Log",
      "description": "Immutable telemetry tracking actions across workspace resources.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "description": "System event ID tracker" },
        "userId": { "type": "string", "description": "Initiator profile reference" },
        "userName": { "type": "string", "description": "Initiator legal name review cached" },
        "action": { "type": "string", "description": "Standard action event key identifier" },
        "entityType": { "type": "string", "description": "Affected target classification catalog" },
        "entityId": { "type": "string", "description": "Affected entity identifier target SKU" },
        "description": { "type": "string", "description": "Details description summary" },
        "createdAt": { "type": "string", "description": "Timestamp setup log" }
      },
      "required": ["logId", "userId", "userName", "action", "entityType", "entityId", "description", "createdAt"]
    },
    "notification": {
      "title": "Notification Log",
      "description": "Log entry recording outbox WhatsApp delivery efforts for auditability.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "description": "Unique log identifier" },
        "tenantId": { "type": "string", "description": "SaaS space reference key" },
        "transactionId": { "type": "string", "description": "Triggering POS transaction invoice context" },
        "customerPhone": { "type": "string", "description": "WhatsApp destination mobile number" },
        "templateType": { "type": "string", "description": "Template slug identifier" },
        "provider": { "type": "string", "description": "Selected gateway operator slug" },
        "status": { "type": "string", "enum": ["sent", "failed"], "description": "Outcome of gateway sending" },
        "responseMessage": { "type": "string", "description": "Remote response log description message" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "sentBy": { "type": "string", "description": "Staff operator UID who triggered" },
        "sentByName": { "type": "string", "description": "Staff operator name profile label" }
      },
      "required": ["notificationId", "tenantId", "transactionId", "customerPhone", "templateType", "provider", "status", "createdAt", "sentBy"]
    },
    "automationJob": {
      "title": "Automation Job",
      "description": "Event-driven automation task managing queued WhatsApp or SMS messages.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "description": "Unique job identifier" },
        "tenantId": { "type": "string", "description": "Tenant owner context" },
        "outletId": { "type": "string", "description": "Branch division context" },
        "type": { "type": "string", "enum": ["send_receipt", "ready_pickup", "overdue_pickup", "partial_payment_reminder", "custom_manual"], "description": "Categorized job purpose" },
        "transactionId": { "type": "string", "description": "Associated invoice tracking" },
        "customerId": { "type": "string", "description": "Associated CRM profile" },
        "customerName": { "type": "string", "description": "Saved customer display name" },
        "customerPhone": { "type": "string", "description": "Destination phone target normalized format" },
        "message": { "type": "string", "description": "Transmitted literal message" },
        "deliveryChannel": { "type": "string", "enum": ["whatsapp"], "description": "Operational media" },
        "status": { "type": "string", "enum": ["queued", "processing", "sent", "failed", "cancelled"], "description": "Pipeline execution status" },
        "retryCount": { "type": "number", "description": "Counter for failed execution attempts" },
        "maxRetries": { "type": "number", "description": "Ceiling limit bounds for automatic re-queueing" },
        "createdBy": { "type": "string", "description": "Staff cashier Uid who registered transaction" },
        "createdByName": { "type": "string", "description": "Cached profile names" },
        "triggeredBy": { "type": "string", "enum": ["system", "manual", "status_change", "payment_update", "checkout"], "description": "Context driver of event creation" },
        "errorMessage": { "type": "string", "description": "Internal server raw explanation stack" },
        "isDeleted": { "type": "boolean", "description": "Logical deletion safety parameter" },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO" },
        "updatedAt": { "type": "string", "description": "Modification timestamp ISO" },
        "sentAt": { "type": "string", "description": "Dispatch actual execution time ISO" },
        "nextRetryAt": { "type": "string", "description": "Chronological coordinate calculating delays" }
      },
      "required": ["jobId", "tenantId", "outletId", "type", "customerName", "customerPhone", "message", "deliveryChannel", "status", "retryCount", "maxRetries", "createdBy", "createdByName", "triggeredBy", "isDeleted", "createdAt", "updatedAt"]
    },
    "notificationLog": {
      "title": "Notification Log Entry V2",
      "description": "Ledger of immutable notification job run delivery attempts and payloads.",
      "type": "object",
      "properties": {
        "logId": { "type": "string" },
        "jobId": { "type": "string" },
        "tenantId": { "type": "string" },
        "outletId": { "type": "string" },
        "transactionId": { "type": "string" },
        "customerId": { "type": "string" },
        "type": { "type": "string" },
        "provider": { "type": "string" },
        "target": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "sent", "failed"] },
        "errorMessage": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["logId", "jobId", "tenantId", "outletId", "type", "provider", "target", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Global user map indexing authentication objects directly to business tenants."
    },
    "/tenants/{tenantId}": {
      "schema": "tenant",
      "description": "Multi-tenant container stores subscription parameters, basic parameters."
    },
    "/tenants/{tenantId}/outlets/{outletId}": {
      "schema": "outlet",
      "description": "Sub-collection listing physical service centers of a specific laundry organization."
    },
    "/tenants/{tenantId}/services/{serviceId}": {
      "schema": "service",
      "description": "Catalogs of services, options, and unit tariff configuration matrices."
    },
    "/tenants/{tenantId}/customers/{customerId}": {
      "schema": "customer",
      "description": "Directory of registered frequent flyers, loyalists, and single customers."
    },
    "/tenants/{tenantId}/employees/{employeeId}": {
      "schema": "employee",
      "description": "Directory tracking registered operators, staff, and payroll schemes."
    },
    "/tenants/{tenantId}/expenses/{expenseId}": {
      "schema": "expense",
      "description": "Workspace operational overhead cost tracking ledger entries branch-isolated."
    },
    "/tenants/{tenantId}/shiftClosings/{shiftId}": {
      "schema": "shiftClosing",
      "description": "Ledger recording cashier cash float, expectations, actual deposits, and closing times."
    },
    "/tenants/{tenantId}/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Ledger listing dispatch notifications, template types, outcomes, and audit lines."
    },
    "/tenants/{tenantId}/automationJobs/{jobId}": {
      "schema": "automationJob",
      "description": "Ledger of point-of-sale and backend notification dispatcher cron entries."
    },
    "/tenants/{tenantId}/notificationLogs/{logId}": {
      "schema": "notificationLog",
      "description": "Ledger of immutable notification job run delivery attempts and payloads."
    },
    "/tenants/{tenantId}/dailyReports/{reportId}": {
      "schema": "dailyReport",
      "description": "Pre-compiled summary metrics keeping dashboard read cost to a lightweight single read per node."
    },
    "/tenants/{tenantId}/activityLogs/{logId}": {
      "schema": "activityLog",
      "description": "Telemetry feed recording crucial adjustments, edits or settings revisions across SaaS units."
    },
    "/tenants/{tenantId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Primary register containing operational and billing details of point-of-sale activities."
    },
    "/tenants/{tenantId}/transactions/{transactionId}/items/{itemId}": {
      "schema": "transactionItem",
      "description": "Item details breakdown sub-ledger separating transaction order list entries to scale footprint."
    }
  }
}
