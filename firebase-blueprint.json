{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile linking Firebase Auth UID to active tenant and roles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["owner", "admin", "kasir", "pegawai"], "description": "Access control role" },
        "tenantId": { "type": "string", "description": "Reference to the owner tenant" },
        "activeOutletId": { "type": "string", "description": "Outlet where the user is currently working" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" }
      },
      "required": ["userId", "name", "email", "role", "tenantId", "createdAt"]
    },
    "tenant": {
      "title": "Tenant",
      "description": "SaaS tenant representing the entire laundry business entity.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string", "description": "Unique tenant ID (often matches Owner ID)" },
        "businessName": { "type": "string", "description": "Name of the Laundry enterprise" },
        "ownerId": { "type": "string", "description": "UID of the owner user" },
        "status": { "type": "string", "enum": ["active", "suspended", "expired"], "description": "Account subscription status" },
        "plan": { "type": "string", "enum": ["free", "basic", "premium"], "description": "Subscription tier" },
        "planExpiresAt": { "type": "string", "format": "date-time", "description": "Expiration timestamp for theoretical paid plans" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Organization registration timestamp" }
      },
      "required": ["tenantId", "businessName", "ownerId", "status", "plan", "createdAt"]
    },
    "outlet": {
      "title": "Outlet",
      "description": "Individual laundry outlet under a specific business tenant.",
      "type": "object",
      "properties": {
        "outletId": { "type": "string", "description": "Unique multi-outlet reference" },
        "name": { "type": "string", "description": "Outlet name (e.g., LaundryKu Cabang Margonda)" },
        "address": { "type": "string", "description": "Physical address" },
        "phone": { "type": "string", "description": "Outlet contact number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Outlet setup timestamp" }
      },
      "required": ["outletId", "name", "address", "createdAt"]
    },
    "service": {
      "title": "Service",
      "description": "Laundry services offered by the tenant (kiloan, satuan, sepatu, dry-clean, etc.).",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string", "description": "Unique service ID" },
        "name": { "type": "string", "description": "Service name (e.g., Cuci+Setrika Reguler)" },
        "type": { "type": "string", "enum": ["kiloan", "satuan", "sepatu", "karpet", "other"], "description": "Service classification" },
        "unit": { "type": "string", "enum": ["kg", "pcs", "pair", "m2"], "description": "Pricing metric unit" },
        "pricePerUnit": { "type": "number", "description": "Cost per single unit" },
        "estimatedDays": { "type": "number", "description": "Processing SLA in days" },
        "isActive": { "type": "boolean", "description": "Availability toggle" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["serviceId", "name", "type", "unit", "pricePerUnit", "estimatedDays", "isActive", "createdAt"]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer profiles registered within the tenant space.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "description": "Unique customer reference" },
        "name": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "WhatsApp compatible phone number" },
        "address": { "type": "string", "description": "Optional home address" },
        "notes": { "type": "string", "description": "Special preferences (e.g., allergic to specific perfume)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Customer registration timestamp" }
      },
      "required": ["customerId", "name", "phone", "createdAt"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Laundry order transactions and POS data.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "description": "Invoice/Order number (e.g., LKU-2026-0001)" },
        "outletId": { "type": "string", "description": "Origin outlet ID" },
        "customerId": { "type": "string", "description": "Associated customer ID" },
        "customerName": { "type": "string", "description": "Cached name to prevent expensive N-reads" },
        "customerPhone": { "type": "string", "description": "Cached phone to prevent expensive N-reads" },
        "items": { "type": "array", "description": "Details of services ordered" },
        "totalAmount": { "type": "number", "description": "Final price after discounts" },
        "discountAmount": { "type": "number", "description": "Applied concession" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "refunded"], "description": "Invoicing stage" },
        "paymentMethod": { "type": "string", "enum": ["cash", "qris", "transfer", "none"], "description": "Applied payment instrument" },
        "orderStatus": { "type": "string", "enum": ["received", "processing", "ready", "delivered"], "description": "Processing milestone status" },
        "weight": { "type": "number", "description": "Total weight in kg if kiloan" },
        "workerId": { "type": "string", "description": "Employee current processor UID" },
        "notes": { "type": "string", "description": "Order specific specifications" },
        "receivedAt": { "type": "string", "format": "date-time", "description": "Order placement timestamp" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Ready confirmation timestamp" },
        "deliveredAt": { "type": "string", "format": "date-time", "description": "Handed back to customer timestamp" }
      },
      "required": ["transactionId", "outletId", "customerId", "customerName", "items", "totalAmount", "paymentStatus", "orderStatus", "receivedAt"]
    },
    "dailyReport": {
      "title": "Daily Report",
      "description": "Pre-aggregated daily transactional summary per outlet to optimize reads and fit free tiers.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "description": "Formatted Date ID (e.g., YYYY-MM-DD_outletId)" },
        "date": { "type": "string", "description": "Formatted Date YYYY-MM-DD" },
        "outletId": { "type": "string", "description": "Associated outlet reference" },
        "totalRevenue": { "type": "number", "description": "Sum of total closed billing collections" },
        "cashRevenue": { "type": "number", "description": "Revenue via Cash" },
        "qrisRevenue": { "type": "number", "description": "Revenue via QRIS" },
        "transferRevenue": { "type": "number", "description": "Revenue via Transfer" },
        "totalOrders": { "type": "number", "description": "Volume of orders logged" },
        "completedOrders": { "type": "number", "description": "Volume of orders delivered" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Aggregation update timestamp" }
      },
      "required": ["reportId", "date", "outletId", "totalRevenue", "totalOrders", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Global user map indexing authentication objects directly to business tenants."
    },
    "/tenants/{tenantId}": {
      "schema": "tenant",
      "description": "Multi-tenant container stores subscription parameters, basic parameters."
    },
    "/tenants/{tenantId}/outlets/{outletId}": {
      "schema": "outlet",
      "description": "Sub-collection listing physical service centers of a specific laundry organization."
    },
    "/tenants/{tenantId}/services/{serviceId}": {
      "schema": "service",
      "description": "Catalogs of services, options, and unit tariff configuration matrices."
    },
    "/tenants/{tenantId}/customers/{customerId}": {
      "schema": "customer",
      "description": "Directory of registered frequent flyers, loyalists, and single customers."
    },
    "/tenants/{tenantId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Primary register containing operational and billing details of point-of-sale activities."
    },
    "/tenants/{tenantId}/dailyReports/{reportId}": {
      "schema": "dailyReport",
      "description": "Pre-compiled summary metrics keeping dashboard read cost to a lightweight single read per node."
    }
  }
}
